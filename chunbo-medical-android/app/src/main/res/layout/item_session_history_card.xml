<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_history_item"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- 左侧精致图标徽标 -->
    <LinearLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_chip_green"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_history_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="会话"
            android:src="@drawable/ic_chat_outline"
            app:tint="@color/primary" />
    </LinearLayout>

    <!-- 中间：标题与时间 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_history_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="儿童布洛芬体重用量禁忌"
            android:textColor="@color/chat_ai_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_history_item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今天 13:45"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_history_item_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@color/surface_variant"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="AI智能提炼"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右侧箭头 -->
    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="选择"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_muted" />

</LinearLayout>
