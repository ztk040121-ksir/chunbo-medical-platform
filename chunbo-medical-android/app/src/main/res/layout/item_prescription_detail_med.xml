<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_med_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="布洛芬缓释胶囊"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_med_price_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¥26.00 × 1 盒"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_med_spec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="规格: 0.3g*20粒/盒"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_med_subtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="小计: ¥26.00"
            android:textColor="@color/primary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_med_usage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip_green"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="用法: 口服 · 每日1次 · 每次0.3g"
        android:textColor="@color/primary"
        android:textSize="11sp" />

    <View
        android:id="@+id/divider_med"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/divider" />

</LinearLayout>
