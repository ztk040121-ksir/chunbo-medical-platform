<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <!-- 医生/用户消息行 (居右) -->
    <LinearLayout
        android:id="@+id/layout_user_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|top"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="10dp"
            android:gravity="end"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_user_image"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:adjustViewBounds="true"
                android:contentDescription="用户上传的图片"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/tv_user_bubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_bubble_user"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="用户提问内容"
                android:textColor="@color/chat_user_text"
                android:textSize="15sp" />
        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_user_avatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/avatar_resident_1"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="1.5dp" />
    </LinearLayout>

    <!-- AI 临床助手消息行 (居左) -->
    <LinearLayout
        android:id="@+id/layout_ai_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="horizontal"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:minWidth="230dp"
            android:background="@drawable/bg_bubble_ai"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ai_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="春播小药师 · 健康顾问与导医"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_ai_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_emerald"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="执业药师在线"
                    android:textColor="@color/primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 多智能体协同与 MCP 工具调用实时过程卡片（仅在生成过程中显示！） -->
            <LinearLayout
                android:id="@+id/layout_process"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_process_box"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/pb_process"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:indeterminateTint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="⚙️ 处理中..."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_process_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 生成完成后的折叠小标签（收起繁琐的MCP过程，仅展示干净的结果） -->
            <TextView
                android:id="@+id/tv_process_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/surface_variant"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="处理过程 ▾"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:visibility="gone" />

            <!-- RAG 知识库命中标签 -->
            <TextView
                android:id="@+id/tv_rag_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/status_amber_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="合理用药规范与诊疗指南参考 (RAG)"
                android:textColor="@color/warning_text"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_ai_bubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:lineSpacingMultiplier="1.18"
                android:text="您好！我是春播万象健康小药师，已就绪医学知识库与春播商城药品库。"
                android:textColor="@color/chat_ai_text"
                android:textSize="14sp" />

            <!-- 推荐方剂参考卡片 -->
            <LinearLayout
                android:id="@+id/layout_rx_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/status_green_bg"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 推荐方剂参考"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layout_rx_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 春播便民健康商城对症正品在售药品推荐卡片容器 -->
            <LinearLayout
                android:id="@+id/layout_mall_products"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- 快捷推荐胶囊容器 -->
            <LinearLayout
                android:id="@+id/layout_quick_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <!-- 用户消息附带的商品卡片容器（如：订单咨询时展示所购药品，含真实图片） -->
    <LinearLayout
        android:id="@+id/layout_user_products"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone" />

</LinearLayout>
