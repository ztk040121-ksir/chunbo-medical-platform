<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="1.5dp"
    app:strokeColor="@color/surface_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 商品图片区域（京东风格商品大图展示） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:background="@color/background">

            <ImageView
                android:id="@+id/iv_product_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="药品图片"
                android:scaleType="centerCrop"
                tools:srcCompat="@android:drawable/ic_menu_gallery" />

            <!-- 春播正品认证标 -->
            <TextView
                android:id="@+id/tv_card_self_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="@drawable/bg_badge_emerald"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="春播正品"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- 分类气泡标签 -->
            <TextView
                android:id="@+id/tv_card_category_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_badge_emerald"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="感冒用药"
                android:textColor="@color/primary"
                android:textSize="9sp" />

            <!-- 库存标签 -->
            <TextView
                android:id="@+id/tv_card_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="#70000000"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:text="库存 150"
                android:textColor="@color/text_on_primary"
                android:textSize="9sp" />
        </FrameLayout>

        <!-- 商品详细信息与加购区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <!-- 药品通用名称 -->
            <TextView
                android:id="@+id/tv_card_product_name"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="连花清瘟胶囊 (以岭)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 规格与厂家 -->
            <TextView
                android:id="@+id/tv_card_spec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="0.35g*24粒/盒 · 石家庄以岭"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <!-- 适用症卖点小药丸标签 -->
            <TextView
                android:id="@+id/tv_card_pitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@color/status_red_bg"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:text="清瘟解毒 · 宣肺泄热"
                android:textColor="@color/status_red"
                android:textSize="9sp" />

            <!-- 仿京东价格与加购物车圆形红按钮行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:text="¥"
                        android:textColor="@color/status_red"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_card_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26.80"
                        android:textColor="@color/status_red"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_card_original_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="1dp"
                        android:text="¥35"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- 极速加购圆形按钮 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_card_add_cart"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/primary"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="加入购物车"
                        android:src="@drawable/ic_cart" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
