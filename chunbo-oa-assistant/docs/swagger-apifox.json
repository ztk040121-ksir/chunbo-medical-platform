{
  "openapi": "3.0.1",
  "info": {
    "title": "春播助手 OA / 薪资智能体 API 契约文档",
    "description": "基于 Spring AI + Tool Calling 的内部运营系统智能体接口契约，用于对接 Apifox 与前端组件",
    "version": "1.0.0"
  },
  "paths": {
    "/api/assistant/chat": {
      "post": {
        "summary": "与春播助手进行对话式交互（自动触发 Tool Calling）",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "查询我上个月的工资条明细"
                  },
                  "doctorId": {
                    "type": "string",
                    "example": "DOC_1001"
                  }
                },
                "required": [
                  "message"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "大模型调用工具后返回的 Markdown 格式解答"
          }
        }
      }
    },
    "/api/assistant/salary": {
      "get": {
        "summary": "获取指定医生或全员历史工资条明细",
        "parameters": [
          {
            "name": "doctorId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "工资条实体列表"
          }
        }
      }
    },
    "/api/assistant/plaster": {
      "get": {
        "summary": "获取中药特色贴敷疗程与月度营收统计数据",
        "responses": {
          "200": {
            "description": "贴敷总数、总营业额及各病种明细"
          }
        }
      }
    },
    "/api/assistant/approvals": {
      "get": {
        "summary": "获取 OA 请假与调班待办及历史审批流",
        "responses": {
          "200": {
            "description": "审批列表"
          }
        }
      }
    },
    "/api/assistant/approval/create": {
      "post": {
        "summary": "手动或对话式发起审批申请",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "applicantName": {
                    "type": "string"
                  },
                  "approvalType": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "startTime": {
                    "type": "string"
                  },
                  "endTime": {
                    "type": "string"
                  },
                  "durationDays": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "新建审批单信息"
          }
        }
      }
    },
    "/api/assistant/approval/process": {
      "post": {
        "summary": "审批人员处理请假/调班申请（通过/驳回）",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "status": {
                    "type": "string",
                    "example": "已通过"
                  },
                  "approver": {
                    "type": "string",
                    "example": "李文华 (科室主任)"
                  },
                  "comment": {
                    "type": "string",
                    "example": "核准通过"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "处理结果"
          }
        }
      }
    },
    "/api/assistant/token-stats": {
      "get": {
        "summary": "获取大模型 Token 消耗监控与费用核算数据",
        "responses": {
          "200": {
            "description": "Token 总数、平均延迟、累计折算费用"
          }
        }
      }
    }
  }
}